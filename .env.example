# Claude API (parser/ 모듈에서 영유아 카테고리 필터링 및 일정 추출에 사용)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 로그인 세션 (Playwright storage_state 파일 경로)
# 아래 2개는 scraper/*_login.py 를 한 번씩 수동 실행해 직접 로그인하면 자동 생성됩니다.
# (아이디/비번은 이 프로젝트 코드가 절대 저장하거나 자동 입력하지 않습니다 - 매번 브라우저가 뜨면 사람이 직접 로그인)
INPOCK_STORAGE_STATE_PATH=data/inpock_storage_state.json
LITLINK_STORAGE_STATE_PATH=data/litlink_storage_state.json

# 인스타그램 로그인 쿠키 (login_helper.py 를 한 번 실행해 직접 로그인하면 자동 생성됩니다)
INSTA_COOKIES_PATH=data/insta_cookies.json

# 스케줄러(cron_job.py) 실행 주기 (시간 단위, 48~72시간 권장)
CRON_INTERVAL_HOURS=60

# Cloudinary (parser/image_store.py) - 인스타 썸네일을 수집 직후 업로드해 영구 URL로 보관하고,
# 종료일 30일 지난 공구 이미지는 자동 삭제한다. 콘솔 Dashboard > API Keys 에서 확인.
# 셋 중 하나라도 비어 있으면 이미지 보관 단계는 스킵되고(이미지는 인스타 원본 URL 그대로), 파이프라인은 계속 돈다.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 카카오 '나에게 보내기' 자동 발송 (generator/send_to_me.py) - 로컬 테스트용.
# GitHub Actions에서는 같은 이름을 Repository secrets에 등록한다. 값은 절대 커밋하지 말 것.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_REFRESH_TOKEN=
KOPIS_API_KEY=
