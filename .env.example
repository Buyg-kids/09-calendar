# Claude API (parser/ 모듈에서 영유아 카테고리 필터링 및 일정 추출에 사용)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 로그인 세션 (Playwright storage_state 파일 경로)
# 아래 2개는 scraper/*_login.py 를 한 번씩 수동 실행해 직접 로그인하면 자동 생성됩니다.
# (아이디/비번은 이 프로젝트 코드가 절대 저장하거나 자동 입력하지 않습니다 - 매번 브라우저가 뜨면 사람이 직접 로그인)
INPOCK_STORAGE_STATE_PATH=data/inpock_storage_state.json
LITLINK_STORAGE_STATE_PATH=data/litlink_storage_state.json

# 인스타그램 로그인 쿠키 (login_helper.py 를 한 번 실행해 직접 로그인하면 자동 생성됩니다)
INSTA_COOKIES_PATH=data/insta_cookies.json

# 스케줄러(cron_job.py) 실행 주기 (시간 단위, 48~72시간 권장)
CRON_INTERVAL_HOURS=60
